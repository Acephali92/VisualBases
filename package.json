{
  "name": "visualbases",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VisualBases – interactive open-data platform about foreign military bases worldwide",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:build && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "data:import": "node scripts/import-visualbases.mjs",
    "data:build": "node scripts/build-data.mjs",
    "predev": "npm run data:build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
